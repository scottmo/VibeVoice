# TTS model loading. Local mode reads complete checkpoints from models/tts/.
# Set VIBEVOICE_MODEL_SOURCE=huggingface to download a selected model there.
VIBEVOICE_MODEL_SOURCE=local
VIBEVOICE_MODEL=VibeVoice-1.5B
VIBEVOICE_MODELS_DIR=models
VIBEVOICE_ALLOW_SUPPORT_DOWNLOADS=true
# Optional: set true (or HF_HUB_OFFLINE=1) to prohibit every Hugging Face download.
VIBEVOICE_HF_OFFLINE=false
